---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const marks = (await getCollection('marks')).sort((a, b) => a.data.order - b.data.order);

const description =
  'The published list of trademarks and service marks of The Open Accounts Receivable Collective Foundation, and how to ask about using them.';
---

<Base title="Trademarks" description={description}>
  <div class="wrap">
    <div class="page-head">
      <p class="overline">Trademarks</p>
      <h1>The Foundation's Marks</h1>
      <p class="lede">
        The trademarks, service marks, and visual identity of The Open Accounts Receivable
        Collective Foundation identify the Foundation's mission, programs, and software. Their use
        is governed by the Foundation's Trademark Policy.
      </p>
    </div>

    <section class="prose" aria-labelledby="marks-list">
      <h2 id="marks-list">Published list of Marks</h2>
      <p>
        The Marks covered by the Trademark Policy include, without limitation, the following,
        together with any additional Marks the Foundation adopts and identifies in this list:
      </p>
      <ul class="marks plain">
        {
          marks.map((m) => (
            <li>
              <strong>{m.data.mark}</strong>
              <span>{m.data.note}</span>
            </li>
          ))
        }
      </ul>
      <p>
        Common law trademark rights apply from the Foundation's first use of each Mark in commerce,
        regardless of registration status.
      </p>
    </section>

    <section class="prose section-gap" aria-labelledby="policy">
      <h2 id="policy">The Trademark Policy</h2>
      <p>
        The Trademark Policy describes which uses of the Marks are permitted without authorization,
        which require the Foundation's advance written authorization, and how the Foundation
        approaches enforcement. It supplements, but does not modify, the open-source licenses under
        which the Foundation's software is distributed: the license terms govern rights to use,
        modify, and distribute the software, and the Trademark Policy governs use of the
        Foundation's name and visual identity. Read the
        full <a href="/policies/trademark/">Trademark Policy</a>.
      </p>
      <p>
        Detailed specifications for color, sizing, clear space, and acceptable contexts are
        published separately in the Foundation's brand guidelines, which are a technical
        specification rather than a governance instrument.
      </p>
    </section>

    <section class="prose section-gap" aria-labelledby="tm-contact">
      <h2 id="tm-contact">Questions, authorization requests, and reports of misuse</h2>
      <p>
        Direct questions about the policy, requests for authorization, and reports of suspected
        misuse of the Marks
        to <a href="mailto:trademark@openarcollective.org">trademark@openarcollective.org</a>, or
        by mail to the Foundation's <a href="/contact">mailing address</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  h2 {
    margin-bottom: 1rem;
  }

  .section-gap {
    margin-top: 2.75rem;
  }

  .marks {
    margin: 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .marks li {
    border: 1px solid var(--c-line);
    border-left: 3px solid var(--c-amber);
    border-radius: 3px;
    background: var(--c-surface);
    padding: 0.85rem 1.2rem;
  }

  .marks strong {
    display: block;
    font-weight: 600;
  }

  .marks span {
    color: var(--c-text-soft);
    font-size: 0.92rem;
  }
</style>
