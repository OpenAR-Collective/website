---
import Base from '../layouts/Base.astro';
import HexMark from '../components/HexMark.astro';
import HexGlow from '../components/HexGlow.astro';

const description =
  'The OpenAR Collective provides the accounts receivable and debt collection industry with free open-source software, open educational and compliance resources, and a neutral peer community.';
---

<Base title="OpenAR Collective" description={description}>
  <HexGlow />
  <section class="hero">
    <div class="wrap">
      <HexMark size={120} id="hex-hero" />
      <h1>Open<span class="ar">AR</span> Collective</h1>
      <p class="overline legal">The Open Accounts Receivable Collective Foundation</p>
      <p class="tagline">
        Free software, open knowledge, and a neutral community for the accounts receivable
        industry. No fees, no paywalls, and no commercial agenda.
      </p>
      <div class="actions">
        <a href="/join" class="btn btn-primary">Join the Collective</a>
        <a href="/about" class="btn btn-outline">About the Foundation</a>
      </div>
    </div>
  </section>

  <section class="section borderless" aria-labelledby="mission-heading">
    <div class="wrap">
      <p class="overline">Our mission</p>
      <h2 id="mission-heading" class="sr-only">Our mission</h2>
      <blockquote class="mission">
        <p>
          The Open Accounts Receivable Collective Foundation works to make accounts receivable and
          debt collection more transparent, more compliant, and more accountable to the consumers it
          touches. It builds software under an open-source license so anyone can run, inspect,
          modify, and redistribute it at no cost. The Foundation also publishes open educational and
          compliance resources, develops shared standards, delivers training, and maintains a
          neutral, community-governed commons where practitioners learn from one another.
        </p>
      </blockquote>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="pillars-heading">
    <div class="wrap">
      <h2 id="pillars-heading" class="sr-only">What the Foundation does</h2>
      <div class="pillars">
        <div class="pillar">
          <p class="overline">01</p>
          <h3>Open software</h3>
          <p>
            A production-grade accounts receivable and collections platform, released under an
            open-source license, that any organization can download, run, modify, and redistribute
            without a vendor relationship, a license fee, or permission from anyone.
          </p>
          <p><a href="/programs">Explore the software programs</a></p>
        </div>
        <div class="pillar">
          <p class="overline">02</p>
          <h3>Open knowledge</h3>
          <p>
            Compliance and regulatory resources, educational content, shared standards, training,
            and a webinar series, published freely rather than gated behind membership or
            sponsorship.
          </p>
          <p><a href="/programs">See the knowledge programs</a></p>
        </div>
        <div class="pillar">
          <p class="overline">03</p>
          <h3>Neutral community</h3>
          <p>
            A peer space open to every practitioner in the industry, including compliance officers,
            developers, operations managers, collectors, and agency owners, regardless of employer
            size or trade association affiliation.
          </p>
          <p><a href="/join">Become part of the community</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="participate-heading">
    <div class="wrap">
      <p class="overline">Participate</p>
      <h2 id="participate-heading">Two ways to stand with the mission</h2>
      <div class="paths">
        <p>
          Individuals can become members: a free recognition of being part of the Foundation's
          community, with access to the verified practitioner areas of its Discord server.
          Organizations can sign on as Mission Supporters, stating publicly that they support the
          Foundation's mission. Both cost nothing, and neither is available for purchase at any
          price.
        </p>
        <p>
          <a href="/join">Learn about membership and Mission Supporter status</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 5rem 0 4.5rem;
    text-align: center;
    background: radial-gradient(ellipse at 50% 20%, rgba(232, 160, 32, 0.07) 0%, transparent 65%);
  }

  .hero .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero h1 {
    margin-top: 1.75rem;
    font-family: var(--f-wordmark);
    font-weight: 600;
    font-size: clamp(2.4rem, 6.5vw, 3.4rem);
    letter-spacing: 0.01em;
  }

  .hero .ar {
    color: var(--c-amber);
  }

  .legal {
    margin-top: 0.75rem;
    color: rgba(232, 160, 32, 0.62);
  }

  .tagline {
    margin-top: 1.75rem;
    max-width: 34rem;
    color: var(--c-text-soft);
    font-size: 1.15rem;
  }

  .actions {
    margin-top: 2.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .mission {
    margin-top: 1.25rem;
    border-left: 3px solid var(--c-amber);
    padding-left: 1.5rem;
    font-size: 1.12rem;
    color: var(--c-text-soft);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  @media (max-width: 52rem) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }

  .pillar h3 {
    margin: 0.6rem 0 0.75rem;
  }

  .pillar p {
    color: var(--c-text-soft);
    font-size: 0.98rem;
  }

  .pillar p + p {
    margin-top: 0.75rem;
  }

  .paths {
    margin-top: 1.25rem;
  }

  h2 {
    margin-top: 0.5rem;
  }

  .borderless {
    border-top: none;
  }
</style>
