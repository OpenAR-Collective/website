---
import HexGlow from '../components/HexGlow.astro';

const description =
  'The Open Accounts Receivable Collective Foundation works to make accounts receivable and debt collection more transparent, more compliant, and more accountable to the consumers it touches.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenAR Collective</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="OpenAR Collective" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://openarcollective.org/android-chrome-512x512.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0E0D0B" />
    <link
      rel="preload"
      href="/fonts/barlow-semibold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <HexGlow />
    <main>
      <svg viewBox="46 73 420 366" width="96" height="84" aria-hidden="true">
        <defs>
          <linearGradient id="hex" x1="20%" y1="0%" x2="80%" y2="100%">
            <stop offset="0%" stop-color="#F5B830"></stop>
            <stop offset="100%" stop-color="#B87010"></stop>
          </linearGradient>
        </defs>
        <polygon
          points="456,256 356,429.205 156,429.205 56,256 156,82.795 356,82.795"
          fill="url(#hex)"
          stroke="#F8D060"
          stroke-width="9"></polygon>
      </svg>
      <h1>Open<span class="ar">AR</span> Collective</h1>
      <p class="legal-name">The Open Accounts Receivable Collective Foundation</p>
      <p class="mission">
        The Open Accounts Receivable Collective Foundation works to make accounts receivable and
        debt collection more transparent, more compliant, and more accountable to the consumers it
        touches. It builds software under an open-source license so anyone can run, inspect, modify,
        and redistribute it at no cost. The Foundation also publishes open educational and
        compliance resources, develops shared standards, delivers training, and maintains a neutral,
        community-governed commons where practitioners learn from one another.
      </p>
      <p class="status">
        Our full website is on the way. Questions are welcome
        at <a href="mailto:info@openarcollective.org">info@openarcollective.org</a>.
      </p>
    </main>
    <footer>
      <p>&copy; 2026 The Open Accounts Receivable Collective Foundation</p>
    </footer>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('/fonts/barlow-semibold.woff2') format('woff2');
  }
  @font-face {
    font-family: 'Barlow';
    font-style: normal;
    font-weight: 300;
    font-display: swap;
    src: url('/fonts/barlow-light.woff2') format('woff2');
  }

  /* Astro scopes a bare `*` to [data-astro-cid-...], an attribute selector that
     outranks the unscoped `body` rule below and cancelled its side padding, so
     the text sat flush against both edges of a phone screen. :global keeps the
     reset at zero specificity, where a reset belongs. */
  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: #0e0d0b;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem 1.5rem;
    background: radial-gradient(ellipse at 50% 30%, rgba(232, 160, 32, 0.06) 0%, transparent 65%);
    color: #f4efe6;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      sans-serif;
    text-align: center;
  }

  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 46rem;
  }

  h1 {
    margin-top: 1.5rem;
    font-family: 'Barlow', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(2rem, 6vw, 3rem);
    letter-spacing: -0.01em;
  }

  .ar {
    color: #e8a020;
  }

  .legal-name {
    margin-top: 0.5rem;
    font-family: 'Barlow', system-ui, sans-serif;
    font-weight: 300;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #888070;
  }

  .mission {
    margin-top: 2rem;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.75;
    color: rgba(244, 239, 230, 0.82);
    text-align: justify;
  }

  .status {
    margin-top: 2rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  a {
    color: #e8a020;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    color: #f5c050;
  }

  a:focus-visible {
    outline: 2px solid #e8a020;
    outline-offset: 3px;
    border-radius: 2px;
  }

  footer {
    font-size: 0.85rem;
    color: #888070;
  }
</style>
