---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('policies');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Source headings are demoted one level, so the document's ARTICLE headings
// land at depth 2 and make the contents list.
const articles = headings.filter((h) => h.depth === 2);

const adopted = entry.data.adopted.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="wrap">
    <div class="page-head">
      <p class="overline">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <div class="adoption">
        <p>
          Adopted by the Board of Directors of The Open Accounts Receivable Collective Foundation
          on {adopted}.
        </p>
        <ul class="plain signatories">
          <li><span>Rob Grafrath</span> Chair</li>
          <li><span>Porter Heath Morgan</span> Secretary</li>
        </ul>
      </div>
    </div>

    <div class="layout">
      {
        articles.length > 1 && (
          <nav class="toc" aria-labelledby="toc-heading">
            <h2 id="toc-heading" class="overline">
              Contents
            </h2>
            <ol class="plain">
              {articles.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="doc">
        <Content />
      </div>
    </div>

    <p class="back"><a href="/policies/">All policies</a></p>
  </div>
</Base>

<style>
  .adoption {
    margin-top: 1.75rem;
    border-left: 3px solid var(--c-amber);
    padding: 0.9rem 0 0.9rem 1.25rem;
  }

  .adoption p {
    font-size: 0.95rem;
    color: var(--c-text-soft);
  }

  .signatories {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 2.5rem;
  }

  .signatories li {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--c-muted);
  }

  .signatories span {
    display: block;
    color: var(--c-text);
    font-weight: 600;
  }

  .layout {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 3rem;
    align-items: start;
    margin-top: 1rem;
  }

  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .toc {
    position: sticky;
    top: 1.5rem;
    border-top: 1px solid var(--c-line);
    padding-top: 1rem;
  }

  @media (max-width: 60rem) {
    .toc {
      position: static;
    }
  }

  .toc ol {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .toc a {
    color: var(--c-text-soft);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--c-amber);
  }

  /* Document body. Headings come from the adopted text: h2 is an Article,
     h3 a Section, h4 a subheading inside an annexed form. */
  .doc {
    min-width: 0;
  }

  .doc :global(h2) {
    margin: 2.5rem 0 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line);
    font-size: 1.35rem;
    letter-spacing: 0.01em;
  }

  .doc :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .doc :global(h3) {
    margin: 1.75rem 0 0.75rem;
    font-size: 1.08rem;
    color: var(--c-amber);
  }

  .doc :global(h4) {
    margin: 1.5rem 0 0.6rem;
    font-family: var(--f-sans);
    font-weight: 600;
    font-size: 1rem;
  }

  .doc :global(p) {
    margin-bottom: 1rem;
    color: var(--c-text-soft);
  }

  .doc :global(ul),
  .doc :global(ol) {
    margin: 0 0 1rem 0;
    padding-left: 1.5rem;
    color: var(--c-text-soft);
  }

  .doc :global(li) {
    margin-bottom: 0.5rem;
  }

  .doc :global(strong) {
    color: var(--c-text);
    font-weight: 600;
  }

  .doc :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .doc :global(th),
  .doc :global(td) {
    border: 1px solid var(--c-line);
    padding: 0.6rem 0.8rem;
    text-align: left;
    vertical-align: top;
    color: var(--c-text-soft);
  }

  .doc :global(th) {
    background: rgba(22, 20, 16, 0.6);
    color: var(--c-text);
    font-weight: 600;
  }

  /* Editorial note about material omitted from the published version. Styled
     apart from the adopted text so it never reads as part of the policy. */
  .doc :global(.editorial-note) {
    margin-top: 2rem;
    border: 1px dashed var(--c-line);
    border-radius: 3px;
    padding: 0.9rem 1.15rem;
    font-size: 0.88rem;
    font-style: italic;
    color: var(--c-muted);
  }

  .back {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
  }
</style>
