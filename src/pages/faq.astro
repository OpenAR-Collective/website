---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Two parts: who the Foundation is, and what it is building. Sections and
// entries keep the order defined in the collection.
const groupOrder = ['The Foundation', 'The software'];
const groupBlurb: Record<string, string> = {
  'The Foundation': 'Who we are, how we are governed, and how the community works.',
  'The software': 'What we are building, how open source works, and how the platform is run.',
};

const groups = groupOrder.map((groupName) => {
  const inGroup = entries.filter((e) => e.data.group === groupName);
  const sectionNames = [...new Set(inGroup.map((e) => e.data.section))];
  return {
    name: groupName,
    slug: slugify(groupName),
    blurb: groupBlurb[groupName],
    sections: sectionNames.map((name) => ({
      name,
      slug: slugify(name),
      entries: inGroup.filter((e) => e.data.section === name),
    })),
  };
});

const rendered = new Map();
for (const entry of entries) {
  const { Content } = await render(entry);
  rendered.set(entry.id, Content);
}

const description =
  'Answers to common questions about the OpenAR Collective: who the Foundation is and how it is governed, and what it is building in the open.';
---

<Base title="Frequently Asked Questions" description={description}>
  <div class="wrap">
    <div class="page-head">
      <p class="overline">FAQ</p>
      <h1>Frequently asked questions</h1>
      <p class="lede">
        Plain answers in two parts: questions about the Foundation itself, and questions about the
        software it builds. Questions this page does not answer are welcome
        at <a href="mailto:info@openarcollective.org">info@openarcollective.org</a>.
      </p>
    </div>

    <nav class="toc" aria-label="FAQ contents">
      {
        groups.map((g) => (
          <div class="toc-group">
            <p class="overline">{g.name}</p>
            <ul class="plain">
              {g.sections.map((s) => (
                <li>
                  <a href={`#${s.slug}`}>{s.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    {
      groups.map((g) => (
        <section class="group" aria-labelledby={g.slug}>
          <div class="group-head">
            <h2 id={g.slug}>{g.name}</h2>
            <p>{g.blurb}</p>
          </div>
          {g.sections.map((s) => (
            <section class="faq-section" aria-labelledby={s.slug}>
              <h3 id={s.slug}>{s.name}</h3>
              {s.entries.map((entry) => {
                const Content = rendered.get(entry.id);
                return (
                  <details>
                    <summary>{entry.data.question}</summary>
                    <div class="answer">
                      <Content />
                    </div>
                  </details>
                );
              })}
            </section>
          ))}
        </section>
      ))
    }
  </div>
</Base>

<script>
  // Give every prompt block in an answer a clipboard button. textContent
  // rather than innerText so the copied text is the exact source, including
  // its own line breaks, not the soft-wrapped rendering.
  for (const pre of document.querySelectorAll('.answer pre')) {
    const box = document.createElement('div');
    box.className = 'prompt-box';
    pre.replaceWith(box);
    box.appendChild(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy the prompt to the clipboard');
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(pre.textContent?.trim() ?? '').then(
        () => (btn.textContent = 'Copied'),
        () => (btn.textContent = 'Copy failed')
      );
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    });
    box.appendChild(btn);
  }
</script>

<style>
  .toc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--c-line);
  }

  @media (max-width: 40rem) {
    .toc {
      grid-template-columns: 1fr;
    }
  }

  .toc ul {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* Amber is reserved for the links here, so the group labels sit in body
     text color rather than stacking amber on amber. */
  .toc-group > .overline {
    color: var(--c-text);
  }

  .toc a {
    text-decoration: none;
  }

  .group {
    margin-top: 3rem;
  }

  .group-head {
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--c-amber);
  }

  .group-head h2 {
    font-size: 1.75rem;
  }

  .group-head p {
    margin-top: 0.35rem;
    color: var(--c-text-soft);
    font-size: 0.98rem;
  }

  .faq-section {
    margin-top: 2rem;
  }

  .faq-section h3 {
    margin-bottom: 0.9rem;
    font-size: 1.15rem;
    color: var(--c-amber);
  }

  details {
    border: 1px solid var(--c-line);
    border-radius: 3px;
    background: rgba(22, 20, 16, 0.5);
    margin-bottom: 0.6rem;
  }

  summary {
    cursor: pointer;
    padding: 0.9rem 1.1rem;
    font-weight: 550;
    line-height: 1.45;
    list-style-position: outside;
  }

  summary:hover {
    color: var(--c-amber-light);
  }

  details[open] summary {
    color: var(--c-amber);
    border-bottom: 1px solid var(--c-line);
  }

  .answer {
    padding: 1rem 1.25rem 1.25rem;
    color: var(--c-text-soft);
    font-size: 0.98rem;
  }

  .answer :global(p + p) {
    margin-top: 0.85rem;
  }

  .answer :global(ul) {
    padding-left: 1.4rem;
    margin: 0.75rem 0;
  }

  .answer :global(li) {
    margin-bottom: 0.4rem;
  }

  /* Copy-paste blocks, like the AI assistant prompts in the contributing
     entry, wrap instead of forcing a horizontal scroll on small screens. */
  .answer :global(pre) {
    margin-top: 0.85rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--c-line);
    border-radius: 3px;
    background: rgba(22, 20, 16, 0.7);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    line-height: 1.55;
  }

  /* The script below wraps each answer pre in a .prompt-box so the copy
     button can anchor to the box corner instead of scrolling with the text.
     The wrapper takes over the pre's top margin, and the extra right padding
     keeps the first line clear of the button. */
  .answer :global(.prompt-box) {
    position: relative;
    margin-top: 0.85rem;
  }

  .answer :global(.prompt-box pre) {
    margin-top: 0;
    padding-right: 4.75rem;
  }

  .answer :global(.copy-btn) {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--c-line);
    border-radius: 3px;
    background: rgba(22, 20, 16, 0.92);
    color: var(--c-text-soft);
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .answer :global(.copy-btn:hover) {
    color: var(--c-amber-light);
    border-color: var(--c-amber);
  }

  /* Long prompts, marked .prompt-tall in the markdown, scroll inside a
     capped box instead of stretching the page. */
  .answer :global(.prompt-tall pre) {
    max-height: 16rem;
    overflow-y: auto;
  }
</style>
