---
interface Props {
  size?: number;
  id?: string;
  stroke?: number;
}
const { size = 96, id = 'hex', stroke } = Astro.props;
// At small rendered sizes the 9-unit ring falls below a pixel and reads as
// fuzz, so the ring thickens as the mark shrinks: about 1.5px rendered,
// never thinner than the reference 9 units.
const sw = stroke ?? Math.max(9, Math.min(24, Math.round((1.5 * 420) / size)));
const height = Math.round(size * (366 / 420) * 100) / 100;
---

<svg
  viewBox="46 73 420 366"
  width={size}
  height={height}
  aria-hidden="true"
  class="hex-mark"
>
  <defs>
    <linearGradient id={id} x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#F5B830"></stop>
      <stop offset="100%" stop-color="#B87010"></stop>
    </linearGradient>
  </defs>
  <polygon
    points="456,256 356,429.205 156,429.205 56,256 156,82.795 356,82.795"
    fill={`url(#${id})`}
    stroke="#F8D060"
    stroke-width={sw}></polygon>
</svg>
