# Cloudflare Pages redirects. One rule per line: source, destination, status.

# The launch release was published at its 8/14 slug for a few minutes on
# 2026-08-17 before the release date moved to the 17th, so the old path may sit
# in a crawler's index.
/news/2026-08-14-openar-collective-launch/ /news/2026-08-17-openar-collective-launch/ 301

# The brochure's spoken-word address, for saying aloud and printing small.
# 302 rather than 301 so the target can move, to a future /press page for
# instance, without a permanently cached redirect stranding anyone.
/brochure /assets/docs/openar-collective-brochure.pdf 302

# The design decisions record's spoken-word address. 302 so the target can
# move if the record ever gets its own page on this site.
/design https://github.com/OpenAR-Collective/platform-design 302
